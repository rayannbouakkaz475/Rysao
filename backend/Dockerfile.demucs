# RYSAO Studio — image COMPLÈTE avec séparation de pistes IA (Demucs).
# Plus lourde que backend/Dockerfile (installe PyTorch + Demucs), mais la
# séparation « Séparer IA » fonctionne sans aucune installation manuelle.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 ffmpeg git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend

# 1) dépendances légères du studio
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 2) PyTorch + Demucs pour la séparation de pistes.
#    On installe torch depuis PyPI par défaut : compatible à la fois Intel
#    (x86_64) et Apple Silicon (arm64, Mac M1/M2/M3…).
RUN pip install --no-cache-dir torch \
    && pip install --no-cache-dir demucs

# 3) (OPTIONNEL) génération neuronale texte->musique (gros modèle) :
#    décommentez la ligne suivante pour activer MusicGen.
# RUN pip install --no-cache-dir audiocraft

# code + frontend
COPY backend/ /app/backend/
COPY remix.html /app/remix.html

EXPOSE 8000
# $PORT est fourni par l'hébergeur ; 8000 en local.
CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT:-8000}"]
