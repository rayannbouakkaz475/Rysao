{
  "name": "rysao-tcg-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Empaquetage natif iOS/Android (Capacitor) de la PWA RYSAO TCG.",
  "scripts": {
    "copy:web": "node scripts/copy-web.mjs",
    "sync": "npm run copy:web && cap sync",
    "add:ios": "npm run copy:web && cap add ios",
    "add:android": "npm run copy:web && cap add android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "run:ios": "npm run sync && cap run ios",
    "run:android": "npm run sync && cap run android",
    "assets:src": "node scripts/gen-assets.cjs",
    "assets": "capacitor-assets generate --assetPath assets --iconBackgroundColor '#0b1020' --iconBackgroundColorDark '#0b1020' --splashBackgroundColor '#0b1020' --splashBackgroundColorDark '#0b1020'"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.1",
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/push-notifications": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  }
}
