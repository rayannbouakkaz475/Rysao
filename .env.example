# Copiez ce fichier en « .env » et renseignez votre clé.
# Le fichier .env est ignoré par git (voir .gitignore) et ne sera jamais commité.

# Clé API Claude (Anthropic) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# Port d'écoute du serveur (optionnel, défaut : 3000)
PORT=3000

# Code d'accès privé (optionnel). Si défini, la génération de paroles exige ce
# code (saisi dans la page). Laissez vide/commenté pour un usage local sans code.
# ACCESS_CODE=choisissez-un-code-secret
