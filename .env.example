# ============================================================
#  Configuration OnziA Pronostics — copie ce fichier en .env.local
#  NE JAMAIS committer .env.local ni tes vraies clés.
# ============================================================

# --- Données football : choisis UN fournisseur ---
# Le site sélectionne automatiquement le client dans cet ordre de priorité :
#   1. API_FOOTBALL_KEY    (API-Football.com)
#   2. FOOTBALL_DATA_TOKEN (football-data.org)
#   3. aucun -> données de démo

# Option 1 — API-Football.com (api-sports.io). Clé du dashboard api-sports.
API_FOOTBALL_KEY=
# Saison (optionnel). Par défaut calculée automatiquement (ex "2024").
# À renseigner si ton offre cible une saison précise.
API_FOOTBALL_SEASON=

# Option 2 — football-data.org. Token gratuit ou payant.
FOOTBALL_DATA_TOKEN=

# --- IA Claude (Anthropic) ---
# Clé API depuis https://console.anthropic.com/
# Sans clé, l'analyse se limite au modèle statistique maison (toujours gratuit).
ANTHROPIC_API_KEY=

# Modèle Claude utilisé pour l'analyse (optionnel)
ANTHROPIC_MODEL=claude-opus-4-8

# --- Notifications push (Web Push / VAPID) ---
# Génère une paire avec : node scripts/generate-vapid.mjs
# La clé PRIVÉE est un secret : ne jamais la committer.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@onzia.app

# Secret protégeant le cron live (Vercel l'envoie en Authorization: Bearer)
CRON_SECRET=

# Dossier de stockage local (abonnements/état). Défaut : .data
# DATA_DIR=.data

# --- Stockage persistant des abonnements (production) ---
# Si ces variables sont présentes, le site utilise Vercel KV au lieu des
# fichiers locaux. Crée un store KV sur Vercel (Storage -> KV) : les variables
# sont injectées automatiquement. À renseigner ici seulement pour tester KV en local.
KV_REST_API_URL=
KV_REST_API_TOKEN=
