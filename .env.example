# ============================================================
#  Configuration Rysao Pronostics — copie ce fichier en .env.local
# ============================================================

# --- Données football (football-data.org) ---
# Inscris-toi gratuitement sur https://www.football-data.org/client/register
# pour obtenir un token. Sans token, le site utilise des données de démo.
FOOTBALL_DATA_TOKEN=

# --- IA Claude (Anthropic) ---
# Clé API depuis https://console.anthropic.com/
# Sans clé, l'analyse se limite au modèle statistique maison (toujours gratuit).
ANTHROPIC_API_KEY=

# Modèle Claude utilisé pour l'analyse (optionnel)
ANTHROPIC_MODEL=claude-opus-4-8
