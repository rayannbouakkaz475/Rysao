# ============================================================
#  Configuration Rysao — AI Music Video
# ============================================================
# Copie ce fichier en ".env" et remplis ta clé Replicate.
#   cp .env.example .env
#
# Clé API Replicate (obligatoire pour générer de vraies vidéos)
# -> Crée un compte sur https://replicate.com puis :
#    https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Port du serveur web (défaut : 3000)
PORT=3000

# Modèle vidéo par défaut (doit exister dans models.js).
# Exemples : "kling-2.1", "kling-1.6", "minimax", "wan-2.1", "luma-ray"
DEFAULT_MODEL=kling-2.1

# Mode démo : si "true", aucune génération réelle n'est lancée,
# l'app renvoie une vidéo d'exemple. Pratique pour tester l'UI
# sans dépenser de crédits. Mettre "false" pour la vraie génération.
DEMO_MODE=true
